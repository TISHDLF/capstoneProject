import { useState, useEffect, useRef } from "react";
import { useParams, Link } from "react-router-dom";
import { useSession } from "../../context/SessionContext";
import NavigationBar from "../../components/NavigationBar";
import Footer from "../../components/Footer";
import SideNavigation from "../../components/SideNavigation";
import CatBot from "../../components/CatBot";
import axios from "axios";

const handleGoBack = () => {
  window.history.back();
};

const AdopteeForm = () => {
  const printRef = useRef();
  const { user: loggedInUser } = useSession();
  const { cat_id } = useParams();

  const [cat, setCat] = useState(null);
  const [imageSrc, setImageSrc] = useState(
    "/src/assets/icons/CatImages/cat1.jpg"
  );
  const [selectedImage, setSelectedImage] = useState(null);

  const [formData, setFormData] = useState({
    applicant_name: "",
    address: "",
    contact_number: "",
    reason: "",
    document: null,
    cat_id: cat_id, // frontend reference
  });

  useEffect(() => {
    const fetchCat = async () => {
      try {
        const res = await fetch(
          `http://localhost:5000/cats/catprofile/${cat_id}`
        );
        const data = await res.json();

        if (!res.ok) {
          console.error("Backend error:", data.error);
          setCat(null);
          return;
        }

        setCat(data);
      } catch (err) {
        console.error("Error fetching cat:", err);
      }
    };

    fetchCat();
  }, [cat_id]);

  // ✅ Fetch cat images
  useEffect(() => {
    const fetchImages = async () => {
      try {
        const res = await fetch(`http://localhost:5000/cats/${cat_id}/images`);
        if (!res.ok) throw new Error("Failed to fetch images");
        const data = await res.json();

        if (data.length > 0) {
          const primary = data.find((img) => img.is_primary === 1);
          setImageSrc(
            `http://localhost:5000/uploads/cats/${
              primary ? primary.filename : data[0].filename
            }`
          );
        }
      } catch (err) {
        console.error("Error fetching images:", err);
      }
    };

    fetchImages();
  }, [cat_id]);

  // ✅ Handle ID upload preview
  const handleImageChange = (e) => {
    const file = e.target.files[0];
    if (file) {
      setSelectedImage(URL.createObjectURL(file));
      setFormData((prev) => ({ ...prev, document: file }));
    }
  };

  // ✅ Submit adoption form
  const handleSubmit = async (e) => {
    e.preventDefault();
    try {
      const submission = new FormData();

      // ✅ Align with backend fields
      submission.append("adopter", formData.applicant_name); // adopter name
      submission.append("adopter_id", loggedInUser?.user_id || ""); // from session
      submission.append("adoptedcat_id", cat?.cat_id || cat_id); // matches DB column
      submission.append("cat_name", cat?.name || "");
      submission.append("contactnumber", formData.contact_number);
      submission.append("address", formData.address);
      if (formData.document) {
        submission.append("document", formData.document);
      }

      const response = await axios.post(
        "http://localhost:5000/adopt/apply", // make sure this matches your server route
        submission,
        { headers: { "Content-Type": "multipart/form-data" } }
      );

      alert("Application submitted successfully!");
      console.log("✅ Response:", response.data);
    } catch (err) {
      console.error("Error submitting adoption form:", err);
      alert("Failed to submit application.");
    }
  };